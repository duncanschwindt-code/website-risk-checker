# Runtime mode: live or demo. Demo mode accepts only built-in example cases.
APP_MODE=live
PROJECT_USE_MODE=noncommercial
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Provider adapters are privacy-sensitive and disabled by default.
ENABLE_GOOGLE_SAFE_BROWSING=false
ENABLE_URLHAUS=false
ENABLE_PHISHTANK=false
ENABLE_OTX=false
ENABLE_VIRUSTOTAL=false

# Obtain keys only from the official provider pages linked in README.md.
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=

# Strict mode disables a provider whose terms review is overdue.
STRICT_PROVIDER_TERMS=false
PROVIDER_REVIEW_MAX_AGE_DAYS=90

# Application limits. Use a shared production limiter for multi-instance deployments.
APP_RATE_LIMIT_WINDOW_SECONDS=600
APP_RATE_LIMIT_MAX_REQUESTS=10
REQUEST_CONNECT_TIMEOUT_MS=3000
REQUEST_TOTAL_TIMEOUT_MS=7000
MAX_REDIRECTS=3
MAX_PROVIDER_RESPONSE_BYTES=524288
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BASE_MS=250

# Only trust proxy-supplied client IPs after configuring a trusted reverse proxy.
TRUST_PROXY=false
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters

# Owner-supplied private contacts. Do not use public GitHub issues for corrections.
CORRECTION_EMAIL=
PRIVACY_EMAIL=
SECURITY_EMAIL=
LEGAL_CONTACT=

# Optional placeholders used in legal pages.
OPERATOR_LEGAL_NAME=
GOVERNING_JURISDICTION=
LEGAL_EFFECTIVE_DATE=
